# Copy this file to .env (in this backend folder) and fill in the values.
# .env is ignored by Git: never commit the real connection string.

# MongoDB Atlas connection string. The app uses the FigurinesDB database.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Port for the API (the frontend's .env.development expects 5000)
PORT=5000
